          }
        ],
        "prInfo": {
          "number": 31482,
          "title": "[Compiler] Optimize memoization boundaries for nested Server Actions",
          "html_url": "https://github.com/facebook/react/pull/31482",
          "state": "merged",
          "merge_method": "squash",
          "merge_method_key": "github.merge.squash",
          "merged_by": {
            "login": "rickhanlonii",
            "name": "Ricky Hanlon"
          },
