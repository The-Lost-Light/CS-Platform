          "total": 42,
          "additions": 31,
          "deletions": 11
        },
        "files": [
          {
            "filename": "compiler/packages/babel-plugin-react-compiler/src/ReactiveScopes/PruneScopes.ts",
            "status": "modified",
            "additions": 21,
            "deletions": 9,
            "changes": 30,
            "patch": "@@ -44,10 +44,18 @@ export function pruneNonEscapingScopes(fn: HIRFunction): void {\n-      if (value.kind === 'FunctionExpression' && value.loweredFunc.context.length > 0) {\n-        markScopeAsEscaping(value.loweredFunc.id);\n+      if (value.kind === 'FunctionExpression') {\n+        const hasMutableCapture = value.loweredFunc.context.some(\n+          dep => !isStableServerActionRef(dep.identifier)\n+        );\n+        if (hasMutableCapture) {\n+          markScopeAsEscaping(value.loweredFunc.id);\n+        }\n       }"
          },
          {
            "filename": "compiler/packages/babel-plugin-react-compiler/src/__tests__/PruneScopes.test.ts",
            "status": "modified",
            "additions": 10,
            "deletions": 2,
            "changes": 12,
            "patch": "@@ -112,4 +112,10 @@ describe('PruneScopes with Server Actions', () => {\n-  it('marks all nested closures as escaping', () => {\n+  it('elides unnecessary reactive scope wrapper when capturing stable server action', () => {\n+    const result = compileFixture('server-action-loop');\n+    expect(result.code).not.toContain('useMemoCache');\n   });"
          }
        ]
